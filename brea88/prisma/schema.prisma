generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id           Int        @id @default(autoincrement())
  fullName     String
  email        String     @unique
  passwordHash String
  role         String     @default("Agent")
  slug         String     @unique
  phone        String?
  profileImage String?
  bio          String?
  facebook     String?
  messenger    String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  address      String?

  // An agent handles inquiries.
  // Agents do NOT own/manage properties.
  inquiries    Inquiry[]

  @@index([slug])
  @@index([role])
  @@index([isActive])
  @@map("agents")
}

model Property {
  id           Int      @id @default(autoincrement())
  title        String
  tag          String
  category     String?
  propertyType String?
  houseType    String?
  storey       String?
  price        String
  location     String
  image        String
  beds         Int?
  baths        Int?
  sqft         Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  images       String[] @default([])

  // Properties belong to the Admin/property inventory.
  // There is NO agentId here.
  inquiries    Inquiry[]

  @@index([tag])
  @@index([category])
  @@index([propertyType])
  @@index([location])
  @@map("properties")
}

model Inquiry {
  id         Int      @id @default(autoincrement())

  // Client information
  name       String
  email      String
  phone      String
  message    String

  // Property being inquired about
  propertyId Int

  // Agent automatically assigned when the inquiry is created.
  agentId    Int

  // Inquiry workflow
  status     String   @default("New")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([agentId])
  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}