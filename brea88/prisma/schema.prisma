generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id           Int        @id @default(autoincrement())
  fullName     String
  email        String     @unique
  passwordHash String
  role         String     @default("Agent")
  slug         String     @unique
  phone        String?
  address      String?
  profileImage String?
  bio          String?
  facebook     String?
  messenger    String?
  isActive     Boolean    @default(true)

  properties   Property[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([slug])
  @@index([role])
  @@map("agents")
}

model Property {
  id        Int      @id @default(autoincrement())
  title     String
  tag       String
  price     String
  location  String

  image     String
  images    String[] @default([])

  beds      Int?
  baths     Int?
  sqft      Float?

  agentId   Int?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tag])
  @@index([location])
  @@index([agentId])
  @@map("properties")
}