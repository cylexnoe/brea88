generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id           Int       @id @default(autoincrement())
  fullName     String
  email        String    @unique
  passwordHash String
  role         String    @default("Agent")
  slug         String    @unique
  phone        String?
  profileImage String?
  bio          String?
  facebook     String?
  messenger    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  address      String?
  lastSeen     DateTime?

  inquiries           Inquiry[]
  properties          Property[]
  propertySubmissions PropertySubmission[]
  pushSubscriptions   PushSubscription[]

  @@index([slug])
  @@index([role])
  @@index([lastSeen])
  @@map("agents")
}

model Property {
  id            Int      @id @default(autoincrement())
  title         String
  tag           String
  price         String
  location      String
  image         String
  beds          Int?
  baths         Int?
  sqft          Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        String[] @default([])
  agentId       Int?
  category      String?
  propertyType  String?
  houseType     String?
  storey        String?
  developer     String?
  bankFinancing String[] @default([])
  description   String?
  videoUrl      String?
  totalcp       String?
  lotArea       Float?

  inquiries Inquiry[]
  agent     Agent?    @relation(fields: [agentId], references: [id])

  @@index([tag])
  @@index([category])
  @@index([propertyType])
  @@index([location])
  @@index([agentId])
  @@index([developer])
  @@map("properties")
}

model Inquiry {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String
  phone                String
  message              String
  propertyId           Int?
  agentId              Int?
  status               String    @default("New")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  preferredViewingDate DateTime?

  agent    Agent?    @relation(fields: [agentId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([agentId])
  @@index([status])
  @@index([preferredViewingDate])
  @@map("inquiries")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  agentId   Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("push_subscriptions")
}

model PropertySubmission {
  id Int @id @default(autoincrement())

  /**
   * |--------------------------------------------------------------------------
   * | Shareable Form
   * |--------------------------------------------------------------------------
   */

  submissionToken String @unique

  /**
   * |--------------------------------------------------------------------------
   * | Submission Status
   * |--------------------------------------------------------------------------
   * |
   * | Pending Review
   * | Approved
   * | Published
   * | Rejected
   * |
   */

  status String @default("Pending Review")

  /**
   * |--------------------------------------------------------------------------
   * | Submitter Information
   * |--------------------------------------------------------------------------
   */

  submittedByName  String
  submittedByEmail String?
  submittedByPhone String?
  submittedByRole  String?
  companyName      String?

  /**
   * |--------------------------------------------------------------------------
   * | Optional Existing BREA 88 Agent
   * |--------------------------------------------------------------------------
   */

  agentId Int?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  /**
   * |--------------------------------------------------------------------------
   * | Property Information
   * |--------------------------------------------------------------------------
   */

  title        String
  tag          String
  category     String?
  propertyType String?
  houseType    String?
  storey       String?

  price    String
  location String

  beds    Int?
  baths   Int?
  sqft    Float?
  lotArea Float?

  developer String?
  totalcp   String?

  bankFinancing String[] @default([])

  description String?
  videoUrl    String?

  /**
   * |--------------------------------------------------------------------------
   * | Property Images
   * |--------------------------------------------------------------------------
   */

  image  String
  images String[] @default([])

  /**
   * |--------------------------------------------------------------------------
   * | Admin Review
   * |--------------------------------------------------------------------------
   */

  adminNotes String?

  reviewedAt DateTime?
  reviewedBy String?

  /**
   * |--------------------------------------------------------------------------
   * | Published Property
   * |--------------------------------------------------------------------------
   * |
   * | This stores the ID of the Property created when
   * | Admin approves and publishes this submission.
   * |
   */

  publishedPropertyId Int? @unique

  /**
   * |--------------------------------------------------------------------------
   * | Form Feedback
   * |--------------------------------------------------------------------------
   */

  feedback SubmissionFeedback[]

  /**
   * |--------------------------------------------------------------------------
   * | Timestamps
   * |--------------------------------------------------------------------------
   */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([submissionToken])
  @@index([submittedByEmail])
  @@index([agentId])
  @@index([createdAt])
  @@map("property_submissions")
}

model SubmissionFeedback {
  id Int @id @default(autoincrement())

  /**
   * |--------------------------------------------------------------------------
   * | Related Submission
   * |--------------------------------------------------------------------------
   */

  submissionId Int
  submission   PropertySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /**
   * |--------------------------------------------------------------------------
   * | Feedback
   * |--------------------------------------------------------------------------
   */

  rating Int?

  experience    String?
  difficultPart String?
  suggestions   String?

  /**
   * |--------------------------------------------------------------------------
   * | Submitter Information
   * |--------------------------------------------------------------------------
   */

  submittedByName String?
  submittedByRole String?

  /**
   * |--------------------------------------------------------------------------
   * | Timestamp
   * |--------------------------------------------------------------------------
   */

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([rating])
  @@index([createdAt])
  @@map("submission_feedback")
}
