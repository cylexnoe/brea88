generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id           Int        @id @default(autoincrement())
  fullName     String
  email        String     @unique
  passwordHash String
  role         String     @default("Agent")
  slug         String     @unique
  phone        String?
  profileImage String?
  bio          String?
  facebook     String?
  messenger    String?
  isActive     Boolean    @default(true)
  lastSeen     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  address      String?
  inquiries    Inquiry[]
  properties   Property[]

  @@index([slug])
  @@index([role])
  @@index([lastSeen])
  @@map("agents")
}

model Property {
  id           Int       @id @default(autoincrement())
  title        String
  tag          String
  price        String
  location     String
  image        String
  beds         Int?
  baths        Int?
  sqft         Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  images       String[]  @default([])
  agentId      Int?
  category     String?
  propertyType String?
  houseType    String?
  storey       String?
  inquiries    Inquiry[]
  agent        Agent?    @relation(fields: [agentId], references: [id])

  @@index([tag])
  @@index([category])
  @@index([propertyType])
  @@index([location])
  @@index([agentId])
  @@map("properties")
}

model Inquiry {
  id         Int       @id @default(autoincrement())
  name       String
  email      String
  phone      String
  message    String
  propertyId Int?
  agentId    Int?
  status     String    @default("New")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  agent      Agent?    @relation(fields: [agentId], references: [id])
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([agentId])
  @@index([status])
  @@map("inquiries")
}
